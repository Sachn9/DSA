class Solution {
    public char findTheDifference(String s, String t) {
        int freq []=new int[26];

        for(int i=0;i<s.length();i++){
            freq[s.charAt(i)-'a']++;
        }

        for(int j=0;j<t.length();j++){
            char ch=t.charAt(j);
            freq[ch-'a']--;

            if(freq[ch-'a']<0){
                return ch;
            }
        }

        return ' ';
    }
}
