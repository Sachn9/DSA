import java.util.*;

public class Main {
    
    static void ptice(int n, String key) {
        
        int adrianCount = 0;
        int brunoCount = 0;
        int goranCount = 0;

        char[] adrian = {'A','B','C'};
        char[] bruno  = {'B','A','B','C'};
        char[] goran  = {'C','C','A','A','B','B'};

        for(int i = 0; i < n; i++){
            char ch = key.charAt(i);

            if(ch == adrian[i % 3]) adrianCount++;
            if(ch == bruno[i % 4])  brunoCount++;
            if(ch == goran[i % 6])  goranCount++;
        }

        int max = Math.max(adrianCount, Math.max(brunoCount, goranCount));

        System.out.println(max);

        if(adrianCount == max) System.out.println("Adrian");
        if(brunoCount == max)  System.out.println("Bruno");
        if(goranCount == max)  System.out.println("Goran");
    }  
  
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        String str = sc.next();
        ptice(n, str);
        sc.close();
    }
}
