import java.util.*;

public class Main {

    public static void main(String[] args) {
      Scanner scn = new Scanner(System.in);
      int n = scn.nextInt();
	
	    //Write code here
      int res []=new int[n];
      
      for( int i=0;i<n;i++){
        if(i==0){
          res[i]=0;
        }else if(i==1){
          res[i]=1;
        }else{
          int a=res[i-1];
          int b=res[i-2];

          res[i]=(a+b);
        }
      }

      for(int i=0;i<res.length;i++){
        System.out.println(res[i]);
      }

    }
}
