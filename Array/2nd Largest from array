import java.io.*;
import java.util.*;


public class Main {
    public static void SecondLargest(int[] arr, int n) {
        // Write code here
        int firstL=Integer.MIN_VALUE;
        int secondL=Integer.MIN_VALUE;

        for(int i=0;i<n;i++){
            if(arr[i]>firstL){
                secondL=firstL;
                firstL=arr[i];
            }else if(arr[i]>secondL){
                secondL=arr[i];
            }
        }
        System.out.println(secondL);

    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n= sc.nextInt();
        int[] arr= new int[n];

        for(int i=0;i<n;i++)
            arr[i]=sc.nextInt();
            
        SecondLargest(arr,n);
        sc.close();
        
    }
}
