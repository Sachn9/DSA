// Java program to sum two numbers
// represented two arrays.
import java.util.*;

public class Main {

  static int[] subtract(int[] n1, int[] n2) {
    // your code here
    int [] arr1;
    int [] arr2;

    boolean flag=false;
    if(n1.length>n2.length){
      arr1=n1;
      arr2=n2;
    }else if(n1.length==n2.length){
      if(n1[0]>n2[0]){
        arr1=n1;
        arr2=n2;
      }else{
        arr1=n2;
        arr2=n1;
        flag=true;
      }
    }else{
      arr1=n2;
      arr2=n1;
      flag=true;
    }

    int [] ans=new int[Math.max(arr1.length,arr2.length)];
    int borrow=0;
    int i=arr1.length-1;
    int j=arr2.length-1;
    int k=ans.length-1;
    while(i>=0 || j>=0){
      int val1= i>=0 ? arr1[i]:0;
      int val2= j>=0 ? arr2[j]:0;

      if(val1-borrow >= val2){
        int sub=(val1-val2-borrow);
        borrow=0;
        ans[k]=sub;
      } else{
        int sub=(val1+10-borrow)-val2;
        borrow=1;
        ans[k]=sub;
      }
      i--;
      j--;
      k--;

    }

    if(flag){
      System.out.print("-");
    }

    return ans;
  }

  /* Driver program to test above function */
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int n1 = sc.nextInt();
    int[] arr1 = new int[n1];
    for (int i = 0; i < n1; i++) arr1[i] = sc.nextInt();

    int n2 = sc.nextInt();
    int[] arr2 = new int[n2];
    for (int i = 0; i < n2; i++) arr2[i] = sc.nextInt();
    sc.close();

    int[] res = subtract(arr1, arr2);
    for (int i : res) System.out.println(i);
  }
}
