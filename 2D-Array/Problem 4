import java.util.*;

class Accio {
    static int Problem4(int n, int m, int[][] mat) {
        int count = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (mat[i][j] % 2 == 0) {
                    count++;
                }
            }
        }

        return count;
    }
}

public class Main {
    public static void main(String[] args) throws Throwable {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();

        int[][] mat = new int[n][m];

        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < m; ++j) {
                mat[i][j] = sc.nextInt();
            }
        }

        Accio obj = new Accio();
        int ans = obj.Problem4(n, m, mat);

        System.out.println(ans);
    }
}
