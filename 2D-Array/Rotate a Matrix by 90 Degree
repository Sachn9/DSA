import java.io.*;
import java.util.*;

class Solution {
    public int[][] rotateBy90(int [][]mat) {
        // Your code here
        int n=mat.length;
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                int tamp=mat[i][j];
                mat[i][j]=mat[j][i];
                mat[j][i]=tamp;
            }
        }

        for(int i=0;i<n;i++){
            int j=0;
            int k=n-1;

            while(j<k){
                int tamp=mat[i][j];
                mat[i][j]=mat[i][k];
                mat[i][k]=tamp;
                j++;
                k--;
            }
        }

        return mat;

    }
}

