import java.util.*;

public class Main {

	static int FrequencyofDigits(long n, int d) {
        // write code here
        int count=0;
        while(n>0){
            int rem=(int)(n%10);
            if(rem==d){
                count++;
            }
            n /=10;
        }
        return count;
    }
	
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        int d = sc.nextInt();
        System.out.println(FrequencyofDigits(n, d));
    }
}
