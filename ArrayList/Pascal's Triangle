import java.util.*;

public class Main {
    public static void main(String[] args) throws Throwable {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        ArrayList<ArrayList<Integer>> triangle = pascalTriangle(n);
        for (int i = 0; i < triangle.size(); i++) {
            for (int j = 0; j < triangle.get(i).size(); j++) {
                System.out.print(triangle.get(i).get(j) + " ");
            }
            System.out.println();
        }
    }

	public static ArrayList<ArrayList<Integer>> pascalTriangle(int numRows) {
        // write code here
        ArrayList<ArrayList<Integer>> res=new ArrayList<>();

        if(numRows>=1){
            ArrayList<Integer> ans=new ArrayList<>();
            ans.add(1);
            res.add(ans);
        }

        if(numRows>=2){
            ArrayList<Integer> ans=new ArrayList<>();
            ans.add(1);
            ans.add(1);
            res.add(ans);
        }

        for(int i=2;i<numRows;i++){
            ArrayList<Integer> ans=new ArrayList<>();
            ans.add(1);
            ArrayList<Integer> revList=res.get(i-1);
            for(int j=1;j<revList.size();j++){
                ans.add(revList.get(j)+revList.get(j-1));
            }
            ans.add(1);
            res.add(ans);
        }

        return res;
    }

}
