import java.io.*;
import java.util.*;

public class Main {
	public static int triplets(ArrayList<Integer> arr, int X) {

    int count = 0;

    for (int i = 0; i < arr.size() - 2; i++) {

        if (i > 0 && arr.get(i).equals(arr.get(i - 1))) {
            continue;
        }

        int j = i + 1;
        int k = arr.size() - 1;

        int fval = X - arr.get(i);

        while (j < k) {

            int sum = arr.get(j) + arr.get(k);

            if (sum == fval) {

                int leftval = arr.get(j);
                int rightval = arr.get(k);

                count++;

                while (j < k && arr.get(j).equals(leftval)) {
                    j++;
                }

                while (j < k && arr.get(k).equals(rightval)) {
                    k--;
                }

            } else if (sum > fval) {
                k--;
            } else {
                j++;
            }
        }
    }

    return count;
}
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int t;
    t = sc.nextInt();
    while (t > 0) {
      int n, X;
      n = sc.nextInt();
      ArrayList<Integer> arr = new ArrayList<Integer>(n);
      for (int i = 0; i < n; i++) arr.add(sc.nextInt());
      X = sc.nextInt();
      int result = triplets(arr, X);
      System.out.println(result);
      t--;
    }
    sc.close();
  }

  
}
